# ---------------------------------------------------------------------------
# Runtime that setup installs per machine. Never committed.
# ---------------------------------------------------------------------------
backend/python
backend/python/
backend/pythons
backend/pythons/
backend/models
backend/models/
backend/extras/
backend/_cache/

# ImageMagick binaries are downloaded by setup; the ICC profiles are tracked.
backend/ImageMagick/*
!backend/ImageMagick/*.icc

# JPEG XL helpers (cjxl/djxl) are downloaded by setup, per platform.
backend/tools/

# ---------------------------------------------------------------------------
# Per-machine state written by the app
# ---------------------------------------------------------------------------
janai.config.json
janai.runtime.txt
settings.json
settings.json.tmp

# Presets are the user's own; the folder is created on demand.
presets/
logs/
*.log
.tmp/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---------------------------------------------------------------------------
# Editors and OS junk
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Agent working files. Deliberately untracked:
#   .skills/    maintainer-curated guidance for agents, maintained outside
#               this repo's history.
#   MEMORY.md   scratch an agent may leave behind. There is no memory protocol:
#               AGENTS.md and docs/changes.md are the tracked record, so this is
#               ignored rather than kept.
# ---------------------------------------------------------------------------
.skills/
skills/
MEMORY.md
