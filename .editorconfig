# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

# Windows entry points must stay CRLF or cmd.exe mis-parses them
[*.{cmd,bat,ps1}]
end_of_line = crlf

# Shell entry points must stay LF even when edited on Windows
[*.sh]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
